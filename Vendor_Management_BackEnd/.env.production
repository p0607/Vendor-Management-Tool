# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Security
JWT_SECRET=AlchemyTechsol@2026
BCRYPT_ROUNDS=12

# Logging
LOG_LEVEL=info